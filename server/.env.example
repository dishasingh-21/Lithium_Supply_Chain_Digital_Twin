# Copy this file to .env and fill in real values.

# MongoDB connection string. Use a local mongod, Docker Compose (see docker-compose.yml),
# or a MongoDB Atlas cluster.
MONGO_URI=mongodb://127.0.0.1:27017/ev_route_optimizer

# Port the Express API listens on.
PORT=5000

# Max EV range in km used by the A* planner as the "full tank" reference
# (matches MAX_RANGE in the original client-side script).
MAX_RANGE_KM=400

# Average driving speed (km/h) and charging stop duration (minutes) used for ETA estimates.
AVG_SPEED_KMH=60
CHARGE_STOP_MINUTES=30

# Allowed CORS origin for the frontend (set to your deployed frontend URL in production).
CLIENT_ORIGIN=http://localhost:5500

# Required to use POST /api/stations (sent as x-api-key header). Leave unset to disable writes.
# Also gates POST /api/digital-twin/run-scenario.
ADMIN_API_KEY=

# Path to the Python interpreter with the lithium_twin project's dependencies
# installed (simpy, scipy, pulp, networkx, openpyxl) -- used by
# POST /api/digital-twin/run-scenario to shell out to the Python digital twin.
# Usually the repo's own virtualenv, e.g. on Windows:
#   PYTHON_EXECUTABLE=D:\ugproject\EV-charging-ecosystem-Route-Optimization-\.venv\Scripts\python.exe
# Leave unset to use whatever "python" resolves to in the server's own environment.
PYTHON_EXECUTABLE=

# Used by POST /api/digital-twin/run-scenario to generate a plain-English
# explanation of each scenario's results (the Monte Carlo risk paragraph on
# Analyze, and the whole Explain page) via the OpenAI API, instead of the
# deterministic template text. Leave unset to skip this step entirely --
# the site falls back to the deterministic, template-based explanations
# that already exist, so nothing breaks without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NODE_ENV=development
